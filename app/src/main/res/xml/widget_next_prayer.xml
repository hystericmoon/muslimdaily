<?xml version="1.0" encoding="utf-8"?>
<!--
  The prayer-times widget, resizable from 1×1 up; its layout follows its size. Updates are driven
  by the app (an alarm at each prayer time and on settings changes); the 30-minute period moves
  the sky along between them. "keyguard" lets hosts that support lock-screen widgets offer it.
  minWidth/minHeight are the size launchers before Android 12 place it at.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:description="@string/widget_description_picker"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
