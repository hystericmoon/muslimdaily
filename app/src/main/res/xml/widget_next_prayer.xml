<?xml version="1.0" encoding="utf-8"?>
<!--
  Updates are driven by the app (an alarm at each prayer time and on settings changes); the hourly
  period is only a safety net. "keyguard" lets hosts that support lock-screen widgets offer it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:description="@string/widget_next_description_picker"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="50dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:previewLayout="@layout/widget_preview_next"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen|keyguard" />
