<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_text.xml, centred. Its own layout because TextView.setGravity can only be called through
  RemoteViews from Android 12; below that the launcher refused the whole widget ("Problem
  loading widget").
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:fontFamily="google-sans-flex"
    android:fontFeatureSettings="tnum"
    android:fontVariationSettings="'wght' 400"
    android:gravity="center"
    android:includeFontPadding="false"
    android:maxLines="1" />
