<?xml version="1.0" encoding="utf-8"?>
<!-- Live countdown inside the widget (Glance has no chronometer of its own), in the widget's font (see Label). -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="google-sans-flex"
    android:fontFeatureSettings="tnum"
    android:fontVariationSettings="'wght' 400"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textSize="13sp" />
