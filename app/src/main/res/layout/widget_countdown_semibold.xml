<?xml version="1.0" encoding="utf-8"?>
<!-- Live countdown, SemiBold, for the smallest sizes where it stands alone. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="google-sans-flex"
    android:fontFeatureSettings="tnum"
    android:fontVariationSettings="'wght' 600"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textSize="13sp" />
